AWS_ACCESS_KEY=your-access-key-here
AWS_SECRET_KEY=your-secret-key-here

# Which bucket THIS process reads. On your machine it must be dev: the fetchers
# write here, and the local app is where you confirm new data looks right before
# any of it reaches prod. The deployed app sets this to the prod bucket instead.
BUCKET_NAME=fantassistant-lambda-dev

# The two ends of `python promote.py`, which is the only thing that writes to prod.
# Read separately from BUCKET_NAME so promoting can never be pointed at the wrong
# bucket by a stray edit to the line above.
DEV_BUCKET_NAME=fantassistant-lambda-dev
PROD_BUCKET_NAME=euroguru-prod

# EuroLeague Fantasy API (fantaking-api.dunkest.com).
# Personal, account-scoped Bearer token in the form {id}|{secret}. Grab it from the
# fantasy site: DevTools -> Network -> any fantaking-api request -> authorization header.
# It expires; when it does, every fetch fails with a 401 and must be re-copied.
DUNKEST_API_TOKEN=your-bearer-token-here
# 49 = EuroLeague 2026-27. The token's account must be enrolled in this competition
# or the API returns 403. Bump this for a new season.
DUNKEST_COMPETITION_ID=49
